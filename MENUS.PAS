end;

function NewSubMenu(const ACaption: string; hCtx: integer; const AName: string; const AItems: array of TMenuItem; AEnabled: boolean = true): TMenuItem;
begin
   Result := TUIMenu.NewSubMenu(ACaption, hCtx, AName, AItems, AEnabled);
end;

function NewLine: TMenuItem;
begin
   Result := TUIMenu.NewLine;
end;

function ShortCut(Key: Word; Shift: TShiftState): TShortCut;
begin
   Result := TUICtrl.ShortCut(Key, Shift);
end;

function ShortCutToText(SC: TShortCut): string;
begin
   Result := TUICtrl.ShortCutToText(SC);
end;

function TextToShortCut(const S: string): TShortCut;
begin
