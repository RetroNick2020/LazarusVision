   TMenuItem = TUIMenu.TMenuItem;
   TPopupMenu = TUIMenu.TPopupMenu;

function NewItem(const ACaption: string; AShortCut: TShortCut; AChecked, AEnabled: boolean; AOnClick: TNotifyEvent; hCtx: integer; const AName: string): TMenuItem;
